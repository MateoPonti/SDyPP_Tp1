# ==============================================================================
# Configuración del Entorno de Docker (SDyPP_Tp1)
# Plantilla de ejemplo. Copiar a .env para personalizar valores locales.
# ==============================================================================

# Imagen base de Python (versión ligera)
PYTHON_VERSION=3.11-slim

# Identificadores de usuario y grupo (mínimos privilegios, no-root)
APP_USER=appuser
APP_GROUP=appgroup
APP_UID=1000
APP_GID=1000

# Rutas internas del contenedor
APP_DIR=/app
VENV_PATH=/home/appuser/venv

# Configuración de pruebas y dependencias
REQUIREMENTS_FILE=requirements.txt
DEFAULT_TEST_TARGET=tests/

# Flags de Python y comportamiento del contenedor
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PIP_DISABLE_PIP_VERSION_CHECK=1
